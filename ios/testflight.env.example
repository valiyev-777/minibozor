# Copy to testflight.env and fill in. That file is gitignored: this repository
# is public, and an App Store Connect key id sitting next to an issuer id means
# a leaked .p8 is the only thing between a stranger and the account.
#
# All four come from App Store Connect › Users and Access › Integrations.
KEY_ID=
ISSUER_ID=
TEAM_ID=

# Where the test build looks for the backend.
API_HOST=
