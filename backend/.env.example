MB_ENV=dev
MB_SECRET_KEY=change-me-in-production-use-at-least-32-bytes

# Which database. SQLite for development — no server, no setup, and the file is
# the whole state. Postgres for production. One codebase runs on both; see
# "Postgres" in README.md.
MB_DATABASE_URL=sqlite:///./minibozor.db

# Postgres, when you want it. The password appears twice on purpose: once for
# `docker compose` to initialise the server with, and once inside the URL the
# app connects with. Keep them the same.
#
# `docker compose` reads this file from backend/ automatically, so
# MB_POSTGRES_PASSWORD is what `docker-compose.yml` picks up — it is
# deliberately not in that file, which is committed.
MB_POSTGRES_DB=minibozor
MB_POSTGRES_USER=minibozor
MB_POSTGRES_PASSWORD=change-me
# 5434 because 5432 and 5433 are usually another project's.
MB_POSTGRES_PORT=5434
# MB_DATABASE_URL=postgresql+psycopg://minibozor:change-me@localhost:5434/minibozor
MB_ACCESS_TOKEN_MINUTES=30
MB_REFRESH_TOKEN_DAYS=60
MB_OTP_TTL_SECONDS=120
MB_OTP_DEV_CODE=123456
# Named origins, never a wildcard. With credentials on — the backoffice's
# refresh cookie rides on them — a browser treats `*` as no permission at
# all, so `*` is not permissive, it is broken, and `cors_origin_list` drops
# it. These two are where the backoffice and the courier PWA run in dev.
MB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
