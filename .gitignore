# Logs from ./dev.sh — four dev servers' stdout, rewritten on every start.
.dev-logs/

# Database backups from tools/backup.sh. These hold the real catalogue and
# real orders, so they are data, never source.
backups/

# The desktop app's own download folder, when it lands in the repo.
Claude outputs/

# Stray sqlite files. `backend/.gitignore` already covers the ones that belong
# there; this catches a test run started from the repo root, which leaves a
# 1MB `test.db` here that is nobody's source.
*.db
*.db-journal
*.db-wal
